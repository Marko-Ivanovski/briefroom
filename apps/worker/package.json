    "@nestjs/core": "12.5.0",
    "drizzle-orm": "1.0.0-rc.5",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.22",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
