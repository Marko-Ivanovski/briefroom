DATABASE_URL=
BETTER_AUTH_SECRET=
BRIEFROOM_PUBLIC_URL=
BRIEFROOM_SECRET_KEY=
BRIEFROOM_DATA_DIR=
PORT=
BRIEFROOM_WEB_DIR=
HOST=
# Test only, never set in production. Registers the internal testkit module.
BRIEFROOM_TESTKIT=
# Test only, never set in production. Includes the testkit module in the web build.
VITE_BRIEFROOM_TESTKIT=
# Compose install (docker/compose.yml).
POSTGRES_PASSWORD=
# Comma list of reverse proxy IPs or CIDR ranges whose X-Forwarded-For is believed. Empty trusts none.
BRIEFROOM_TRUSTED_PROXIES=
# Interface the app port is published on. Defaults to 127.0.0.1.
BRIEFROOM_BIND=
# Image tag to run. Defaults to latest.
BRIEFROOM_VERSION=
# Name or address clients use to reach the install under the lan profile. Defaults to localhost.
BRIEFROOM_HOST=
# Host port for Caddy under the lan profile. Defaults to 443.
BRIEFROOM_HTTPS_PORT=
COMPOSE_PROFILES=
